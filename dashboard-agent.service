[Unit]
Description=Dashboard Metrics Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=dashboard-agent
Group=dashboard-agent
EnvironmentFile=-/etc/default/dashboard-agent
EnvironmentFile=-/etc/dashboard-agent
EnvironmentFile=-/etc/dashboard-agent.env
EnvironmentFile=-/var/lib/dashboard-agent/agent.env
ExecStart=/usr/local/lib/dashboard-agent/agent.py
Restart=always
RestartSec=2

PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/dashboard-agent /usr/local/lib/dashboard-agent
AmbientCapabilities=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
